# Дан массив целых чисел , nums отсортированный в порядке неубывания . Необходимо удалить дубликаты НА МЕСТЕ таким образом, чтобы каждый уникальный элемент встречался только один раз . Относительный порядок элементов должен оставаться неизменным .
#Считайте количество уникальных элементов равным  nums. После удаления дубликатов верните количество уникальных элементов  .k​​​​​​​k
#Первые  k элементы массива  nums должны содержать уникальные числа в отсортированном порядке . Остальные элементы после индекса  k - 1 можно игнорировать.
# ДОПУСТИМО ИСПОЛЬЗОВАТЬ ЗАРАНЕЕ ИЗВЕСТНЫЙ ОБЪЕМ ПАМЯТИ( Т.Е. РАЗРЕШАЕТСЯ СОЗДАТЬ МАССИВ ДЛИНОЙ CONST, ОДНАКО НЕЛЬЗЯ ДЛИНОЙ LEN(NUMS)...

# №1 Очень медленное решение, однако идея не очень сложная
class Solution:
    def removeDuplicates(self, nums: list[int]) -> int:
        c = 0
        i = 1
        while i < len(nums):   
            if nums[i] == '_':
                break
          
            if nums[i] == nums[i-1]:
                c+=1
                for j in range(i,len(nums)-1):
                    nums[j] = nums[j+1]
                nums[-1] = '_'
                i-=1
            i+=1
        return len(nums)-c


# №2 Оптимальное решение. 
class Solution:
    def removeDuplicates(self, nums: list[int]) -> int:
        place = 1
        c = 1
        k = nums[0]
        for i in range(1, len(nums)):
            if nums[i] != k:
                nums[place] = nums[i]
                place+=1
                k = nums[i]
                c+=1

        return c
