'''Даны две строки needleи haystack. Верните индекс первого вхождения строки needleв haystack, или , -1если needleстрока не является частью haystack.'''
class Solution:
    def strStr(self, haystack, needle):
        for i in range(len(haystack) - len(needle) + 1):
            if haystack[i:i+len(needle)] == needle:
                return i
        return -1
