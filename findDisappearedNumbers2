#более оптимальный вариант решения задачи на поиск выбывших чисел. Используется множество
class Solution:
    def findDisappearedNumbers(self, nums: List[int]) -> List[int]:
        count = {i for i in range(1, len(nums)+1)}
        ans = set(nums)
        a = list(sorted(list(count - ans)))
        return a
