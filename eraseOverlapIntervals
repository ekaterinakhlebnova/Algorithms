'''Дана последовательность интервалов, intervalsв которой задано , верните минимальное количество интервалов, которое необходимо удалить, чтобы оставшиеся интервалы стали непересекающимися .intervals[i] = [starti, endi]

Обратите внимание , что интервалы, которые соприкасаются только в одной точке, не перекрываются . Например, [1, 2]и [2, 3]не перекрываются.'''

class Solution:
    def eraseOverlapIntervals(self, intervals: list[list[int]]) -> int:
        intervals.sort(key = lambda x: x[1])
        end = intervals[0][1]
        count = 0
        for i in range(1,len(intervals)):
            if intervals[i][0] < end:
                count += 1
            else:
                end = intervals[i][1]
        return count
