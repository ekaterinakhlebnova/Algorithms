# 1. Читаем файл построчно
with open("rosalind_subs (1).txt", "r") as file:
    lines = file.read().splitlines()
    dna = lines[0]
    sub = lines[1]

# Создаем список для хранения найденных индексов
positions = []
sub_len = len(sub)

# 2. Идем циклом по ДНК. 
# Ограничиваем диапазон, чтобы срез не вылетал за границы строки
for i in range(len(dna) - sub_len + 1):
    # Берем кусочек ДНК нужной длины и сравниваем с подстрокой
    if dna[i:i + sub_len] == sub:
        # Rosalind просит индексы с 1, поэтому делаем +1
        positions.append(str(i + 1))

# 3. Объединяем список чисел в одну строку через пробел и выводим
print(' '.join(positions))
