'''
Дана последовательность элементов, в intervals которой , 
необходимо объединить все перекрывающиеся интервалы и вернуть массив неперекрывающихся интервалов, 
которые покрывают все интервалы во входном массиве .intervals[i] = [starti, endi]
'''

class Solution:
    def merge(self, intervals: list[list[int]]) -> list[list[int]]:

        intervals.sort(key = lambda x: x[0])
        merged = [intervals[0]]
        
        for i in range(1,len(intervals)):

            cur_start = intervals[i][0]
            cur_end = intervals[i][1]
            last_end = merged[-1][1]

            if cur_start <= last_end:
                merged[-1][1] = max(last_end,cur_end)
            else:
                merged.append(intervals[i])
                
                
        return merged   
