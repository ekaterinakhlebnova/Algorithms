#Дан массив numsцелых nчисел, где nums[i]находится в диапазоне [1, n]. Верните массив всех целых чисел в диапазоне [1, n] , которые не встречаются в nums .
class Solution:
    def findDisappearedNumbers(self, nums: List[int]) -> List[int]:
        count = {i:0 for i in range(1, len(nums)+1)}
        ans = list()
        for i in range(len(nums)):
            count[nums[i]] +=1
        for key, value in count.items():
            if value == 0:
                ans.append(key)
        return list(sorted(ans))
