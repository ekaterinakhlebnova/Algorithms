class Solution:
    def isAnagram(self, s: str, t: str) -> bool:
        ds = {}
        if len(s)!=len(t):
            return False
        for char in s:
            if char in ds:
                ds[char] += 1
            else:
                ds[char] = 1
        for char in t:
            if char in ds:
                ds[char] -= 1
            else:
                return False
        if all(v==0 for v in ds.values()):
            return True
        return False
