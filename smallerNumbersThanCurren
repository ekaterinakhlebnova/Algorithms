'''Дан массив nums, для каждого nums[i]нужно определить, сколько чисел в массиве меньше его. То есть для каждого nums[i]необходимо подсчитать количество допустимых значений , j's таких что  j != i и nums[j] < nums[i] .

Верните ответ в виде массива.

 

Пример 1:

Входные данные: nums = [8,1,2,2,3]
 Выходные данные: [4,0,1,1,3]
 Пояснение: 
Для nums[0]=8 существует четыре меньших числа, чем оно (1, 2, 2 и 3).
Для nums[1]=1 не существует меньшего числа, чем оно.
Для nums[2]=2 существует одно число меньшее, чем оно (1).
Для nums[3]=2 существует одно меньшее число, чем оно (1).
Для nums[4]=3 существует три меньших числа, чем оно (1, 2 и 2).'''


class Solution:
    def smallerNumbersThanCurrent(self, nums: List[int]) -> List[int]:
        ans = list(sorted(nums))
        o = list()
        d = dict()
        d[ans[0]]=0
        for i in range(1,len(ans)):
            if ans[i] != ans[i-1]:
                d[ans[i]] = i
        for i in range(len(nums)):
            o.append(d[nums[i]])
                
        return o
